# Required secrets for the production deployment. Set both before starting.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# Allowed public hostnames. Separate multiple hosts with commas.
DJANGO_ALLOWED_HOSTS=makemoneyordie.com,www.makemoneyordie.com
SITE_URL=https://makemoneyordie.com
CORS_ALLOWED_ORIGINS=https://makemoneyordie.com,https://www.makemoneyordie.com,http://localhost:9005,http://127.0.0.1:9005
BOT_INTEGRATION_TOKEN=

# Optional OpenRouter defaults. The admin's saved settings take precedence.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_SITE_URL=https://makemoneyordie.com
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_INPUT_CHARS=16000
OPENROUTER_MAX_OUTPUT_TOKENS=9000
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_RETRY_ATTEMPTS=3

# Stripe Checkout and protected digital-book delivery.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOOK_TITLE=Make Money or Die
BOOK_PRICE_CENTS=1900
BOOK_CURRENCY=eur
BOOK_FILE_PATH=/app/private/make-money-or-die.pdf
BOOK_DOWNLOAD_MAX_AGE=86400
